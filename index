  ], correct:1, expl:'Зріз додає кнопки-фільтри поруч із таблицею чи діаграмою — натискання миттєво змінює показані дані без правки формул.'},
  {q:'За таблицею з розділу «Завдання»: скільки коштує сума продажів Олексія (рядки №4, 8, 9)?', opts:[
    '19 600 грн','55 400 грн','75 300 грн','18 900 грн'
  ], correct:2, expl:'19600 + 36800 + 18900 = 75300 грн — саме це порахує SUMIFS за умовою «Менеджер = Олексій».'}
];

const root = document.getElementById('quiz');
let score = 0;
document.getElementById('score-max').textContent = QUESTIONS.length;

function build(){
  root.innerHTML = '';
  score = 0;
  document.getElementById('score-val').textContent = '0';
  QUESTIONS.forEach((item, qi) => {
    const div = document.createElement('div');
    div.className = 'q';
    const p = document.createElement('p');
    p.className = 'qtext';
    p.textContent = (qi+1) + '. ' + item.q;
    div.appendChild(p);
    const optsWrap = document.createElement('div');
    optsWrap.className = 'opts';
    const expl = document.createElement('div');
    expl.className = 'expl';
    expl.textContent = item.expl;
    item.opts.forEach((optText, oi) => {
      const btn = document.createElement('button');
      btn.className = 'opt';
      btn.textContent = optText;
      btn.addEventListener('click', () => {
        if (div.dataset.answered) return;
        div.dataset.answered = '1';
        [...optsWrap.children].forEach((b, bi) => {
          if (bi === item.correct) b.classList.add('correct');
          else if (bi === oi) b.classList.add('wrong');
        });
        if (oi === item.correct) { score++; document.getElementById('score-val').textContent = score; }
        expl.classList.add('show');
      });
      optsWrap.appendChild(btn);
    });
    div.appendChild(optsWrap);
    div.appendChild(expl);
    root.appendChild(div);
  });
}
document.getElementById('restart').addEventListener('click', build);
build();

// download capability
(async () => {
  const btn = document.getElementById('download-btn');
  let downloads = null;
  try { downloads = await claude.use('downloads'); } catch(e) { downloads = null; }
  if (!downloads) { btn.remove(); return; }
  btn.addEventListener('click', async () => {
    btn.disabled = true;
    const original = btn.textContent;
    try {
      const html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
      await downloads.save({filename: 'konspekt_urok_funktsii_zvedeni_tablytsi.html', data: html});
      btn.textContent = '✓ Збережено';
    } catch (e) {
      btn.textContent = 'Не вдалося зберегти';
    } finally {
      setTimeout(() => { btn.textContent = original; btn.disabled = false; }, 2200);
    }
  });
})();
</script>


